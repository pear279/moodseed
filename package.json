{
  "name": "moodseed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "Moodseed 情绪植物拼图 — 情绪记录 + CBT + 植物拼图成长",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/smoke.mjs",
    "test:unit": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply moodseed-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply moodseed-db --remote",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
